      "domain": "access-control",
      "input": "Administrators can read user profiles.",
      "expected": {
        "parsed": true,
        "query_type": "entailment",
        "solver_outcome": "UNSAT",
        "conflict": false,
        "attributes": {
          "subject": "Administrators",
          "action": "Read",
          "resource": "UserProfiles",
          "effect": "Allow",
          "conditions": [],
          "interpretation": "role_permission"
        },
        "fol_formula": "∀x (Administrators(x) → CanRead(x, UserProfiles))",
        "inference_conclusions": [
          "Administrators(Alice) → CanRead(Alice, UserProfiles)",
          "CanRead(Alice, UserProfiles)"
        ]
      },
      "rationale": "A role permission is entailed for the deterministic request individual."
