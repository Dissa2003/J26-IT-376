# Copy to .env and adjust. Loaded by shared_contracts.config.
APP_ENV=local
LOG_LEVEL=INFO

# Service URLs (docker-compose DNS names; use localhost:<port> outside Docker)
INGESTION_URL=http://ingestion:8001
PROCESSING_URL=http://processing:8002
ENGINE_URL=http://engine:8003
GATEWAY_URL=http://api_gateway:8000

# Mock dependency (ingestion broker upgrade path)
REDIS_URL=redis://redis:6379/0

# Engine
ANOMALY_THRESHOLD=0.8
MODEL_VERSION=stub-0.1

# Gateway
API_KEYS=dev-key-1,dev-key-2
WEBHOOK_URL=http://mock_webhook:8080